          "wavelength_nm": [
            550.0,
            600.0,
            650.0,
            700.0,
            750.0
          ],
          "readout_count": 5
        },
        "holdout": {
          "wavelength_nm": [
            450.0,
            500.0
          ],
          "readout_count": 2
        }
      },
      "hst_2019": {
        "fit": {
          "window_nm": [
            500.0,
            570.0
          ],
          "window_row_count": 255
        },
        "holdout": {
          "window_nm": [
            430.0,
            500.0
          ],
          "upper_exclusive": true,
          "window_row_count": 255
        },
        "pool": {
          "datasets": "grouping.umbral_in_eclipse (committed)",
          "umbral_dataset_count": 2,
          "row_pools_jointly": true
        }
      },
      "event_1990_02_09": {
        "fit": {
          "readout_count": 1,
          "definition": "single whole-disk broadband readout"
        },
        "holdout": "cross-event prediction matrix rows are its holdout account (no event-internal holdout)"
      }
    },
    "objective": {
      "definition": "g(a) = median over the fit subset of ln(P(a)/O); P(a) is the production two-layer baseline kernel prediction with an extra increment column of the pinned morphology at AOD550 = a, built through exactly the committed kernel adapters, solar scaling and observed-ratio benchmarks",
      "monotonicity": "g is nonincreasing in a (each ln ratio decreases with more extinction; the median preserves monotonicity)",
      "root_finder": "scipy.optimize.brentq on [0.0, 2.0], xtol=1e-12",
      "branch_zero_increment": "g(0) <= 0 -> required increment is 0; recorded as status zero_increment with a finding, not an error",
      "branch_unclosed": "g(2.0) > 0 -> the preregistered bracket cannot close the event; recorded as status unclosed with a finding; no forced closure at any larger AOD (lane discipline)",
      "branch_dark_top": "if any fit-subset P(a) underflows to <= 0 at the bracket top (the model transmits no measurable light; the vacuum branch carries ~1e-16 float noise), the top is 'dark' and the event is closable within the preregistered bracket; the finite bracket top is found by geometric halving, and the first finite point is guaranteed negative: tau*a there is within a factor 2 of the underflow cliff (~745), hence P << O; brentq then runs on [0, a_finite] and monotonicity leaves the root unchanged (every a <= a_finite has P > 0 because the underflow cliff is monotone in a)",
      "status_vocabulary": [
        "inverted",
        "zero_increment",
        "unclosed"
      ]
    },
    "observation_sources": {
      "june_2011": {
        "product": "validation/results/round2/analysis.json",
        "field": "records[*].observed_curve_brightness"
      },
      "dec_2011": {
        "product": "validation/results/dec2011/comparison.json",
        "field": "records[*].observed_curve_ratio"
      },
      "hst_2019": {
        "product": "validation/results/hst2019/comparison.csv",
        "field": "rows[*].{dataset}_obs_ratio"
      },
      "event_1990_02_09": {
        "product": "validation/results/multiple_events/analysis.json",
        "field": "observed = prediction / model_to_observed (variant=fixed_opac, exact same-record recovery)"
      }
    },
    "consistency_criterion": {
      "statistic": "R = max/min over the four events' main-form inverted AOD550",
      "systematic_gap": "R <= 2.0",
      "partially_consistent": "2.0 < R <= 10.0",
      "event_specific": "R > 10.0",
      "band_edge_source": "VERDICT_COMPATIBLE[1] / VERDICT_TENSION[1] imported from extinction_gap_diagnosis (single verdict vocabulary)",
      "degenerate_branch": "any event without a valid inversion value (zero increment or unclosed) -> not_applicable + findings[] record (the max/min ratio degenerates)",
      "auxiliary": "geometric mean and population geometric standard deviation describe the spread only and never carry the verdict"
    },
