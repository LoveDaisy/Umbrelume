    },
    "retrieval_spec_rules": {
      "aod550_range": "[min/10, max*10] over events with valid inversion values; a zero-increment event enters min as 0; unclosed events are excluded from the range and recorded in findings[]",
      "spectral_coverage": "sensitivity-morphology Angstrom envelope (alpha_blue in [0.2, 1.11], alpha_visible in [0.17, 1.42]) union the main form's values",
      "layer_geometry": "0-10 km class exponential layer, scale height of the pinned row in use (main form: antarctic/scale_height_m)",
      "source_types": "boundary-layer / lower-tropospheric aerosol optical types (OPAC-like) with humidity variants (the RH rows' unavailable status in the pinned source is the known gap)",
      "branch_rule": "any inversion value above the pinned boundary-layer upper bound (0.625) appends volcanic / stratospheric-perturbation source types"
    },
    "dimensional_form": {
      "statement": "P(a) is built through exactly the kernel adapters, solar scaling and observed-ratio benchmarks that produced the committed predictions; per readout residual = ln(P(a)/O) with O recovered from committed fields only",
      "mechanical_criterion": "P(0)/O reproduces the committed *_model_to_observed per readout within MOMENT_TOLERANCE (the kernel re-sums its terms, so exact bitwise equality holds only at the committed-value level, which is asserted separately); a zero increment restores the baseline prediction bitwise"
    }
